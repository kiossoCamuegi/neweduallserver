const MONTH_NAMES_PT = [
  "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
  "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"
];

// ✅ O campo `fee.month` costuma vir no formato "M.YYYY" (ex: "0.2025" = Janeiro/2025,
// "1.2021" = Fevereiro/2021), onde a parte inteira é o índice do mês (0 = Janeiro)
// e a parte decimal é o ano. Esta função separa os dois valores com segurança.
function parseFeeMonth(rawMonth) {
  if (rawMonth === null || rawMonth === undefined) return null;

  const str = String(rawMonth).trim();
  if (!str) return null;

  const [monthPart, yearPart] = str.split('.');
  const monthIndex = Number(monthPart);
  const year = yearPart !== undefined ? Number(yearPart) : null;

  if (isNaN(monthIndex)) return null;

  return {
    monthIndex,
    year: (year !== null && !isNaN(year)) ? year : null,
  };
}

// Converte um fee (mês de propina) no rótulo legível, ex: "Janeiro 2025"
function formatFeeMonth(fee) {
  const parsed = parseFeeMonth(fee.month);

  if (parsed) {
    const monthName = MONTH_NAMES_PT[parsed.monthIndex] || `Mês ${parsed.monthIndex}`;
    return parsed.year ? `${monthName} ${parsed.year}` : monthName;
  }

  // Fallback caso o backend já mande o nome pronto ou o formato seja outro
  return fee.month_name || `Mês ${fee.month}`;
}

