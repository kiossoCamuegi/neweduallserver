function FeespaymentsTable() {
  const [data,          setData]          = useState([]);
  const [LoadStatus,    setLoadStatus]    = useState(null);
  const [importedCount, setImportedCount] = useState(0);

  function computeLine(item) {
    const price       = item.ed_fee_payment_price * 1;
    const discountPct = item.ed_fee_payment_discount * 1 || 0;
    const ivaPct      = item.ed_fee_payment_iva * 1 || 0;
    const fineType    = item.ed_fee_payment_fineType * 1 || 0;
    const fineValue   = item.ed_fee_payment_fineValue * 1 || 0;

    const afterDiscount = price - (price * discountPct) / 100;
    const base          = ivaPct > 0 ? afterDiscount / (1 + ivaPct / 100) : afterDiscount;
    const fineAmount    = fineType === 1 ? fineValue : (base * fineValue) / 100;
    const total         = afterDiscount + fineAmount;

    return { total };
  }

  async function loadData() {
    try {
      setLoadStatus(0);
      const response = await axios.get(TABLEURL);
      const grouped  = {};

      (response.data || []).forEach((item) => {
        const { total }       = computeLine(item);
        const key             = item.ed_fee_payment_invoiceCode;
        const deleteUrl       = Hoot() + `eduallfeepaymentsdelete/delete/${item.ed_fee_payment_id}`;
        const fromServiceFlag = (item.ed_fee_payment_from_service * 1) === 1;
        const extrasArray     = item.extras ? JSON.parse(item.extras) : [];
        const extrasTotal     = Array.isArray(extrasArray)
          ? extrasArray.reduce((sum, ex) => sum + (Number(ex.amount) || 0), 0)
          : 0;

        if (!grouped[key]) {
          const isImp = String(item.ed_fee_payment_invoiceCode || "").startsWith("IMP-")
                     || !!item.ed_fee_payment_external_origin;

          grouped[key] = {
            id:                    item.ed_fee_payment_id,
            service:               item.ed_service_title || (isImp ? "Pag. de propinas (Importação)" : ""),
            coin:                  item.ed_coin_code,
            code:                  item.ed_fee_payment_invoiceFile || item.ed_service_payment_invoiceCode,
            paymentCode:           item.ed_fee_payment_code,
            student:               item.ed_fee_payment_student,
            name:                  item.ed_student_name,
            studentcode:           item.ed_student_code,
            picture:               item.ed_student_picture,
            months:                [item.ed_fee_payment_month],
            balance:               total,
            extrasTotal,
            price:                 item.ed_fee_payment_price,
            invoiceN:              item.ed_fee_payment_invoiceCode,
            date:                  moment(item.ed_fee_payment_registerDate).format("DD [de] MMMM [de] YYYY [às] HH:mm"),
            invoiceCount:          1,
            paymentsUrls:          [deleteUrl],
            extras:                extrasArray,
            extrasAdded:           false,
            fromService:           fromServiceFlag,
            bankName:              item.ed_fee_payment_bank             || "",
            bordereauNumber:       item.ed_fee_payment_bordereux        || "",
            bordereauStudentCount: Number(item.bordereau_student_count  || 0),
            bordereauOriginal:     parseFloat(item.bordereau_original_value || 0),
            bordereauUsed:         parseFloat(item.bordereau_used_value     || 0),
            externalOrigin:        item.ed_fee_payment_external_origin  || null,
          };
        } else {
          grouped[key].balance += total;
          grouped[key].months.push(item.ed_fee_payment_month);
          grouped[key].invoiceCount += 1;
          grouped[key].paymentsUrls.push(deleteUrl);
          if (fromServiceFlag) grouped[key].fromService = true;
          if (!grouped[key].bankName && item.ed_fee_payment_bank)
            grouped[key].bankName = item.ed_fee_payment_bank;
          if (!grouped[key].bordereauNumber && item.ed_fee_payment_bordereux) {
            grouped[key].bordereauNumber       = item.ed_fee_payment_bordereux;
            grouped[key].bordereauStudentCount = Number(item.bordereau_student_count || 0);
            grouped[key].bordereauOriginal     = parseFloat(item.bordereau_original_value || 0);
            grouped[key].bordereauUsed         = parseFloat(item.bordereau_used_value     || 0);
          }
          if (!grouped[key].externalOrigin && item.ed_fee_payment_external_origin)
            grouped[key].externalOrigin = item.ed_fee_payment_external_origin;
        }

        if (!grouped[key].extrasAdded && extrasTotal > 0) {
          grouped[key].balance     += extrasTotal;
          grouped[key].extrasTotal  = extrasTotal;
          grouped[key].extras       = extrasArray;
          grouped[key].extrasAdded  = true;
        }
      });

      const rows = Object.values(grouped).map((g, index) => ({
        ...g,
        index: index + 1,
        monthsLabel: g.months
          .map((m) => {
            if (!m) return "";
            let mm, yy, monthName;
            if (String(m).includes(".")) {
              [mm, yy] = String(m).split(".");
              const monthIndex = parseInt(mm, 10);
              monthName = !isNaN(monthIndex) && monthIndex >= 0 && monthIndex <= 11
                ? Months[monthIndex] : mm;
            } else if (String(m).includes("-")) {
              const parts = String(m).split("-");
              monthName = parts[0] || ""; yy = parts[1] || "";
            } else {
              monthName = m; yy = "";
            }
            return `${monthName} de ${yy}`;
          })
          .filter(Boolean)
          .join(", "),
        fromService: !!g.fromService,
      }));

      setData(rows);
      setImportedCount(rows.filter(r => isImportedPayment(r)).length);
      setLoadStatus(2);
    } catch (error) {
      console.error("Erro ao carregar pagamentos:", error);
      setLoadStatus(1);
    }
  }

  useEffect(() => { loadData(); }, []);

  const deleteImportedTitle = `${importedCount} pagamento(s) importado(s) — esta acção é irreversível`;

  return (
    <div id="ed-custom-table-data">
      <TableGrid
        TableHead={columns}
        TableBody={data}
        TableTitle="Propinas pagas"
        TableBtn={
          <div className="ed-flex" style={{ alignItems: "center", gap: 6, flexWrap: "wrap" }}>
            <button
              id="ed-custom-table-data-btn"
              onClick={() =>
                ExportDataToTablesToPdf({
                  fileName:        "Lista dos pagamentos de propinas",
                  headerId:        null,
                  contentId:       "ed-custom-table-data",
                  footerId:        null,
                  rotation:        "landscape",
                  buttonId:        "ed-custom-table-data-btn",
                  customHeader:    "Lista dos pagamentos de propinas",
                  excludedColumns: ["Ação"],
                })
              }
              className="btn-icon ed-flex ed-center btn btn-export-data ml-2 bg-white"
            >
              <PiFilePdfDuotone />
            </button>

            <button
              className="btn-icon btn btn-export-data ml-2"
              onClick={() =>
                ExportDataForTablesExcel("Lista dos pagamentos de propinas", ["Ação"])
              }
            >
              <PiMicrosoftExcelLogoDuotone />
            </button>

             <ImportModal
                config={paymentsImportConfig}
                onSuccess={() => loadData()}
              />

            <RefreshButton action={loadData} status={LoadStatus} />
          </div>
        }
      />
      <br />
    </div>
  );
}

