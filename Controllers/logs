// ════════════════════════════════════════════════════════════════════════════════
// 🎯 MAIN COMPONENT
// ════════════════════════════════════════════════════════════════════════════════
//
// ⚠️ IMPORTANTE: a partir desta versão, o backend (FetchServicePayments) já devolve
// UMA LINHA POR FATURA/PAGAMENTO, com os serviços e propinas agrupados dentro de
// `items[]` e `fees[]` (via JSON_ARRAYAGG no SQL). Já NÃO é necessário reagrupar
// nada aqui no frontend — só mapear a estrutura recebida.
//
function PaidServicesTable() {
  const [data, setData] = useState([]);
  const [load, setLoaded] = useState(false);
  const [LoadStatus, setLoadStatus] = useState(null);

  /**
   * Carregar dados da tabela
   * LoadStatus: 0 = carregando, 1 = erro, 2 = sucesso
   */
  async function loadData() {
    try {
      Logger.log('📊 Iniciando carregamento de dados...');
      setLoaded(false);
      setLoadStatus(0);

      const result = await fetchWithRetry(TABLEURL, {
        method: 'GET',
        timeout: 130000,
      }, 2);

      if (!result.success) {
        Logger.error('Erro ao buscar dados', result.error);
        setLoaded(true);
        setLoadStatus(1);
        return;
      }

      const response = result.data;
      const rawPayments = response?.data || [];

      Logger.log('✅ Dados recebidos', {
        totalPayments: rawPayments.length,
        url: TABLEURL
      });

      // ✅ Cada elemento de rawPayments já é UMA FATURA (não um item solto)
      const rows = rawPayments
        // por segurança, ignora pagamentos/alunos já eliminados, mesmo que o
        // backend já os filtre no SQL
        .filter((payment) => !payment?._summary?.isPaymentDeleted)
        .map((payment, index) => {
          try {
            const items = Array.isArray(payment.items) ? payment.items : [];
            const fees = Array.isArray(payment.fees) ? payment.fees : [];
            const summary = payment._summary || {};

            // ⚠️ Deteta itens/propinas de registos antigos cujo preço histórico
            // não foi gravado na altura do pagamento. Sem esse valor, a soma do
            // total fica incompleta/errada — por isso tratamos como "sem
            // informação". Mesma lógica usada em PopServicePaymentDetailsModal:
            //   - Serviço: válido se `unit_price` > 0 OU `price_historical === 1`
            //   - Propina: válida se `price` > 0
            const hasItemWithMissingPrice = items.some((it) => {
              const hasPrice = it.unit_price !== null && it.unit_price !== undefined && Number(it.unit_price) > 0;
              const hasHistorical = it.price_historical === 1;
              return !(hasPrice || hasHistorical);
            });

            const hasFeeWithMissingPrice = fees.some((fee) => {
              const hasPrice = fee.price !== null && fee.price !== undefined && Number(fee.price) > 0;
              return !hasPrice;
            });

            // ── Data do pagamento (guarda também o timestamp cru p/ ordenar) ─
            const registerDateObj = parseSafeDate(payment.ed_service_payment_registerDate);
            const registerDateTimestamp = registerDateObj ? registerDateObj.getTime() : 0;

            // ── Nomes dos serviços ──────────────────────────────────────
            // ✅ Sem itens identificados na fatura => coluna vazia ("Consultar fatura")
            const servicesEmpty = items.length === 0;
            const servicesLabel = servicesEmpty
              ? ''
              : items.map((it) => it.service_title || `Serviço ${it.service_id}`).join(', ');

            // ── Quantidade total (soma das quantidades de cada item) ────
            // ✅ Sem itens identificados na fatura, a quantidade "0" não tem
            //    significado real => também mostra o estado vazio.
            const quantityEmpty = items.length === 0;
            const totalQuantity = items.reduce(
              (sum, it) => sum + (Number(it.quantity) || 0), 0
            );

            // ── Desconto ─────────────────────────────────────────────────
            const discountEmpty =
              payment.ed_service_payment_discount === null ||
              payment.ed_service_payment_discount === undefined;

            // ── Total da fatura (já vem calculado do backend) ───────────
            // ✅ Total é considerado "sem informação" (mostra "Consultar fatura")
            //    quando:
            //    1) não há itens identificados na fatura, ou
            //    2) o valor cru do total não veio (null/undefined), ou
            //    3) existe pelo menos um item de serviço sem preço histórico
            //       gravado (registo antigo, unit_price ausente/0 e sem flag
            //       price_historical), ou
            //    4) existe pelo menos uma propina sem preço histórico gravado
            //       (fee.price ausente/0).
            //    Em qualquer um destes casos a soma calculada ficaria
            //    incompleta, por isso evitamos mostrar um total errado.
            const totalRaw = (typeof summary.totalAmount === 'number')
              ? summary.totalAmount
              : payment.ed_service_payment_value_delivered;
            const totalEmpty =
              items.length === 0 ||
              totalRaw === null ||
              totalRaw === undefined ||
              hasItemWithMissingPrice ||
              hasFeeWithMissingPrice;
            const totalValue = Number(totalRaw) || 0;

            // ── Propinas: converte o índice do mês em nome (0 = Janeiro) ─
            let feeMonthsLabel = "Não";
            if (fees.length > 0) {
              const sortedFees = fees.slice().sort((a, b) => {
                const pa = parseFeeMonth(a.month) || { monthIndex: 0, year: 0 };
                const pb = parseFeeMonth(b.month) || { monthIndex: 0, year: 0 };
                if ((pa.year || 0) !== (pb.year || 0)) {
                  return (pa.year || 0) - (pb.year || 0);
                }
                return pa.monthIndex - pb.monthIndex;
              });
              const monthsFormatted = sortedFees.map((fee) => formatFeeMonth(fee));
              feeMonthsLabel = `${fees.length} mês(es): ${monthsFormatted.join(", ")}`;
            }

            return {
              id: payment.ed_service_payment_id,
              index: index + 1,
              invoice: payment.ed_service_payment_invoiceCode,
              paymentDate: formatPaymentDate(payment.ed_service_payment_registerDate),
              _registerDateTimestamp: registerDateTimestamp,
              filecode: payment.ed_service_payment_file_code,
              student: payment.ed_student_name,
              picture: payment.ed_student_picture,
              services: servicesLabel,
              servicesEmpty,
              quantity: totalQuantity,
              quantityEmpty,
              discount: `${payment.ed_service_payment_discount ?? 0}%`,
              discountEmpty,
              total: `${NumberToPrice(totalValue)} ${payment.ed_coin_code || ''}`.trim(),
              totalEmpty,
              feemonths: feeMonthsLabel,
            };
          } catch (rowError) {
            Logger.error(`Erro ao processar pagamento ${payment?.ed_service_payment_id}`, rowError.message);
            return null;
          }
        })
        .filter(Boolean);

      // ✅ Garantir ordenação por data de pagamento (mais recente primeiro),
      // independente da ordem em que a API devolveu os dados.
      rows.sort((a, b) => b._registerDateTimestamp - a._registerDateTimestamp);

      // Reajustar o índice depois de ordenar
      rows.forEach((row, i) => { row.index = i + 1; });

      Logger.log(`✅ Dados processados com sucesso`, {
        totalRows: rows.length,
      });

      setData(rows);
      setLoaded(true);
      setLoadStatus(2);

    } catch (error) {
      Logger.error('❌ Erro geral ao carregar dados', error);
      setLoaded(true);
      setLoadStatus(1);
    }
  }

  useEffect(() => {
    loadData();
  }, []);

  return (
    <div id="ed-custom-table-data">
      <TableGrid
        TableHead={columns}
        TableBody={data}
        TableTitle='Serviços pagos (agrupados por fatura)'
        TableBtn={
          <div className='ed-flex'>
            <button
              id='ed-custom-table-data-btn'
              onClick={() =>
                ExportDataToTablesToPdf({
                  fileName: "Pagamentos de Serviços Agrupados",
                  headerId: null,
                  contentId: "ed-custom-table-data",
                  footerId: null,
                  rotation: "landscape",
                  buttonId: "ed-custom-table-data-btn",
                  customHeader: "Lista dos pagamentos agrupados por fatura",
                  excludedColumns: ["Ação"]
                })
              }
              className='btn-icon ed-flex ed-center btn btn-export-data ml-2 bg-white'
            >
              <PiFilePdfDuotone />
            </button>

            <button
              className='btn-icon btn btn-export-data ml-2'
              onClick={() =>
                ExportDataForTablesExcel(
                  "Pagamentos Agrupados",
                  ["Ação"],
                  "ed-custom-table-data"
                )
              }
            >
              <PiMicrosoftExcelLogoDuotone />
            </button>

            <RefreshButton action={loadData} status={LoadStatus} />
          </div>
        }
      />
    </div>
  );
}

export default PaidServicesTable;



