                  </div>
                  {desconto > 0 && (
                    <div className="col-md-6 mb-2">
                      <small style={{ color: '#6c757d' }}>Desconto ({desconto}%)</small>
                      <p style={{ margin: 0, fontWeight: 600, fontSize: '1.1rem', color: '#dc3545' }}>
                        -{NumberToPrice(valorDesconto)} {invoice._raw?.ed_invoice_coin || 'AOA'}
                      </p>
                    </div>
                  )}
                </div>
                <hr style={{ margin: '0.75rem 0' }} />
                <div className="row">
                  <div className="col-12">
                    <small style={{ color: '#6c757d' }}>Total</small>
                    <p style={{ margin: 0, fontWeight: 700, fontSize: '1.3rem', color: '#28a745' }}>
                      {NumberToPrice(total)} {invoice._raw?.ed_invoice_coin || 'AOA'}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </Tab>

          <Tab eventKey="items" title="Items" className="p-4">
            {items && items.length > 0 ? (
              <div style={{ overflowX: 'auto' }}>
                <table className="table table-sm table-bordered" style={{ marginBottom: 0 }}>
                  <thead className="table-light">
                    <tr>
                      <th style={{ width: '40%' }}>Descrição</th>
                      <th style={{ width: '15%', textAlign: 'right' }}>Quantidade</th>
                      <th style={{ width: '20%', textAlign: 'right' }}>Preço Unitário</th>
                      <th style={{ width: '10%', textAlign: 'center' }}>Desconto</th>
                      <th style={{ width: '15%', textAlign: 'right' }}>Subtotal</th>
                    </tr>
                  </thead>
                  <tbody>
                    {items.map((item, idx) => {
                      const itemSubtotal = (item.quantity || 1) * (item.unit_price || 0);
                      const itemComDesconto = itemSubtotal - (itemSubtotal * (item.discount || 0) / 100);

                      return (
                        <tr key={idx}>
                          <td>
                            <strong>{item.title || item.ed_service_title || '—'}</strong>
                            {item.is_custom && (
                              <span style={{
                                marginLeft: '0.5rem',
                                fontSize: '0.85rem',
                                color: '#6c757d',
                              }}>
                                (personalizado)
                              </span>
                            )}
                          </td>
                          <td style={{ textAlign: 'right' }}>
                            {item.quantity || 1}
                          </td>
                          <td style={{ textAlign: 'right' }}>
                            {NumberToPrice(item.unit_price || 0)}
                          </td>
                          <td style={{ textAlign: 'center', color: item.discount > 0 ? '#dc3545' : '#999' }}>
                            {item.discount || 0}%
                          </td>
                          <td style={{ textAlign: 'right', fontWeight: 600 }}>
                            {NumberToPrice(itemComDesconto)}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            ) : (
              <p className="text-muted">Nenhum item registado.</p>
            )}
          </Tab>

          <Tab eventKey="pagamento" title="Pagamento" className="p-4">
            <div className="mb-4">
              <h6 style={{ fontWeight: 700, marginBottom: '1rem', color: '#333' }}>
                Detalhes de Pagamento
              </h6>

              <div className="mb-3">
                <small style={{ color: '#6c757d', fontSize: '0.85rem' }}>Método de Pagamento</small>
                <div style={{ marginTop: '0.5rem' }}>
                  <span
                    style={{
                      display: 'inline-block',
                      padding: '0.35rem 0.75rem',
                      borderRadius: '20px',
                      backgroundColor: paymentInfo.color + '20',
                      color: paymentInfo.color,
                      fontWeight: 600,
                      fontSize: '0.9rem',
                    }}
                  >
                    {paymentInfo.label}
                  </span>
                </div>
              </div>

              {invoice._raw?.ed_invoice_payment_bank && (
                <div className="mb-3">
                  <small style={{ color: '#6c757d', fontSize: '0.85rem' }}>Banco</small>
                  <p style={{ margin: 0, fontWeight: 600, fontSize: '1rem' }}>
                    {invoice._raw.ed_invoice_payment_bank}
                  </p>
                </div>
              )}

              {invoice._raw?.ed_invoice_payment_place && (
                <div className="mb-3">
                  <small style={{ color: '#6c757d', fontSize: '0.85rem' }}>Local de Pagamento</small>
                  <p style={{ margin: 0, fontWeight: 600, fontSize: '1rem' }}>
                    {invoice._raw.ed_invoice_payment_place}
                  </p>
                </div>
              )}

              {invoice.bordereau !== '—' && (
                <div className="mb-3">
                  <small style={{ color: '#6c757d', fontSize: '0.85rem' }}>Número de Borderô ou Referência</small>
                  <p style={{ margin: 0, fontWeight: 600, fontSize: '1rem' }}>
                    {invoice.bordereau}
                  </p>
                </div>
              )}

              {invoice._raw?.ed_invoice_value_delivered && Number(invoice._raw.ed_invoice_value_delivered) > 0 && (
                <div className="mb-3">
                  <small style={{ color: '#6c757d', fontSize: '0.85rem' }}>Valor Entregue</small>
                  <p style={{ margin: 0, fontWeight: 600, fontSize: '1rem' }}>
                    {NumberToPrice(invoice._raw.ed_invoice_value_delivered)} {invoice._raw?.ed_invoice_coin || 'AOA'}
                  </p>
                </div>
              )}

              <hr />

              <div style={{ background: '#f8f9fa', padding: '1rem', borderRadius: '6px' }}>
                <small style={{ color: '#6c757d', fontSize: '0.85rem' }}>Total Pago</small>
                <p style={{ margin: 0, fontWeight: 700, fontSize: '1.3rem', color: '#28a745' }}>
                  {invoice.total}
                </p>
              </div>
            </div>
          </Tab>

          <Tab eventKey="observacoes" title="Observações" className="p-4">
            {invoice.observations ? (
              <div style={{
                background: '#f8f9fa',
                padding: '1rem',
                borderRadius: '6px',
                borderLeft: '4px solid #007bff',
              }}>
                <p style={{ whiteSpace: 'pre-wrap', margin: 0 }}>
                  {invoice.observations}
                </p>
              </div>
            ) : (
              <p className="text-muted">Nenhuma observação registada.</p>
            )}
          </Tab>
        </Tabs>
      </Modal.Body>

      <Modal.Footer className="bg-light border-top">
        <div className="ed-space" style={{ width: '100%' }}>
          <div className="ed-flex" style={{ gap: '0.5rem' }}>
            <button
              onClick={handlePrint}
              className="btn btn-sm btn-outline-secondary"
              title="Imprimir fatura"
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: '0.5rem',
              }}
            >
              <PrintIcon style={{ fontSize: '1.1rem' }} />
              Imprimir
            </button>

            {invoice.pdfUrl && (
              <DownloadInvoicePDFButton
                documentId={invoice.pdfUrl}
                fileName={`fatura-${invoice.code}.pdf`}
              />
            )}
          </div>

          <div>
            <Button
              variant="secondary"
              size="sm"
              onClick={handleClose}
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: '0.5rem',
              }}
            >
              <CloseIcon style={{ fontSize: '1.1rem' }} />
              Fechar
            </Button>
          </div>
        </div>
      </Modal.Footer>
    </Modal>
  );
}

// ════════════════════════════════════════════════════════════════════════════════
// Modal — Emitir Nova Fatura (React Bootstrap + DraggableModal)
// ════════════════════════════════════════════════════════════════════════════════

function NewInvoiceModal(props) {
  const [show, setShow] = useState(false);
  const [showBox, setShowBox] = useState(false);
  const [RegisterStatus, setRegisterStatus] = useState(null);
  const [errors, setErrors] = useState({});

  const [clientName, setClientName] = useState('');
  const [clientNif, setClientNif] = useState('');
  const [clientPhone, setClientPhone] = useState('');
  const [clientAddress, setClientAddress] = useState('');
  const [clientEmail, setClientEmail] = useState('');
  const [observations, setObservations] = useState('');

  const [allServices, setAllServices] = useState([]);
  const [selectedServices, setSelectedServices] = useState([]);
  const [amounts, setAmounts] = useState({});
  const [serviceCoin, setServiceCoin] = useState('Kz');

  const [otherServiceName, setOtherServiceName] = useState('');
  const [otherServiceValue, setOtherServiceValue] = useState('');

  const [paymentType, setPaymentType] = useState('');
  const [paymentBank, setPaymentBank] = useState('');
  const [paymentPlace, setPaymentPlace] = useState('');
  const [bordereauNumber, setBordereauNumber] = useState('');
  const [valueDelivered, setValueDelivered] = useState('');
  const [discountPercent, setDiscountPercent] = useState(0);

  const [invoiceValue, setInvoiceValue] = useState(0);

  const handleClose = () => {
    setShowBox(false);
    setTimeout(() => setShow(false), 1200);
  };

  const handleShow = () => {
    setShowBox(true);
    setShow(true);
    setTimeout(() => {
      loadServices();
    }, 400);
  };

  const loadServices = async () => {
    try {
      const res = await axios.get(Hoot() + 'eduallservicesapi/get');
      const options = (res.data || []).map((srv) => ({
        label: srv.ed_service_title,
        value: srv.ed_service_id,
        price: Number(srv.ed_service_price) || 0,
        coin: srv.ed_coin_code || 'Kz',
      }));

      options.push({
        label: 'Outros (serviço personalizado)',
        value: OUTROS_SERVICE_ID,
        price: 0,
        coin: 'Kz',
        isCustom: true,
      });

      setAllServices(options);
      if (options.length) setServiceCoin(options[0].coin || 'Kz');
    } catch (error) {
      toast.error('Erro ao carregar serviços!');
      console.error('Erro ao carregar serviços:', error.message);
    }
  };

  const hasOtherService = selectedServices.some((s) => s.value === OUTROS_SERVICE_ID);

  useEffect(() => {
    setAmounts((prev) => {
      const next = { ...prev };
      selectedServices.forEach((s) => {
        if (s.value !== OUTROS_SERVICE_ID && !next[s.value]) next[s.value] = 1;
      });
      Object.keys(next).forEach((id) => {
        if (!selectedServices.find((s) => String(s.value) === String(id))) delete next[id];
      });
      return next;
    });
    if (selectedServices.length) {
      const first = allServices.find((a) => a.value === selectedServices[0].value);
      if (first?.coin) setServiceCoin(first.coin);
    }
  }, [selectedServices, allServices]);

  useEffect(() => {
    let total = 0;
    selectedServices.forEach((s) => {
      if (s.value === OUTROS_SERVICE_ID) {
        total += Number(otherServiceValue) || 0;
      } else {
        const data = allServices.find((a) => a.value === s.value);
        const qty = amounts[s.value] || 1;
        total += (data?.price || 0) * qty;
      }
    });
    const discounted = total - (total * (Number(discountPercent) || 0)) / 100;
    setInvoiceValue(discounted);
  }, [selectedServices, amounts, otherServiceValue, discountPercent, allServices]);

  const changeAmount = (serviceId, delta) => {
    setAmounts((prev) => {
      const current = prev[serviceId] || 1;
      return { ...prev, [serviceId]: Math.max(1, current + delta) };
    });
  };

  const setField = (field, value) => {
    if (!!errors[field]) setErrors((prev) => ({ ...prev, [field]: null }));
  };

  const validateForm = () => {
    const NewErrors = {};
    setRegisterStatus(0);

    if (!clientName || clientName.trim() === '') NewErrors.client_name = 'O nome do cliente é obrigatório.';
    if (selectedServices.length === 0) NewErrors.services = 'Deve adicionar pelo menos um serviço ou item.';
    if (paymentType === '' || paymentType === null || paymentType === undefined)
      NewErrors.payment_type = 'Seleccione o método de pagamento.';

    if (hasOtherService) {
      if (!otherServiceName.trim()) NewErrors.other_service_name = 'Indique o nome do serviço personalizado.';
      if (!otherServiceValue || Number(otherServiceValue) <= 0)
        NewErrors.other_service_value = 'Indique um valor válido para o serviço personalizado.';
    }

    if (Number(paymentType) !== 0 && paymentType !== '' && !bordereauNumber.trim())
      NewErrors.bordereau_number = 'Indique o número de borderô ou referência para este método.';

    if (discountPercent < 0 || discountPercent >= 100) NewErrors.discount_percent = 'A percentagem de desconto é inválida (0-99).';

    return NewErrors;
  };

  const resetForm = () => {
    setClientName('');
    setClientNif('');
    setClientPhone('');
    setClientAddress('');
    setClientEmail('');
    setObservations('');
    setSelectedServices([]);
    setAmounts({});
    setOtherServiceName('');
    setOtherServiceValue('');
    setPaymentType('');
    setPaymentBank('');
    setPaymentPlace('');
    setBordereauNumber('');
    setValueDelivered('');
    setDiscountPercent(0);
    setInvoiceValue(0);
    setErrors({});
    ClearInputs();
  };

  const FormSubmit = async (e) => {
    e.preventDefault();

    const formErrors = validateForm();
    if (Object.keys(formErrors).length > 0) {
      setErrors(formErrors);
      toast.error('Verifique todos os campos obrigatórios.');
      setRegisterStatus(1);
      return;
    }

    const items = selectedServices.map((s) => {
      if (s.value === OUTROS_SERVICE_ID) {
        return {
          service_id: null,
          title: otherServiceName.trim(),
          quantity: 1,
          unit_price: Number(otherServiceValue) || 0,
          discount: 0,
          is_custom: true,
        };
      }
      const info = allServices.find((a) => a.value === s.value);
      return {
        service_id: s.value,
        title: s.label,
        quantity: amounts[s.value] || 1,
        unit_price: info?.price || 0,
        discount: 0,
        is_custom: false,
      };
    });

    const payload = {
      client_name: clientName.trim(),
      client_nif: clientNif || null,
      client_phone: clientPhone || null,
      client_address: clientAddress || null,
      client_email: clientEmail || null,
      observations: observations || null,
      payment_type: Number(paymentType),
      payment_bank: paymentBank || null,
      payment_place: paymentPlace || null,
      payment_reference: bordereauNumber || null,
      value_delivered: Number(valueDelivered) || 0,
      discount_percent: Number(discountPercent) || 0,
      coin: serviceCoin,
      items,
    };

    try {
      const response = await axios.post(Hoot() + 'eduallregisterinvoice/post/', payload);
      toast.success(
        response.data.msg
          ? `${response.data.msg} (Nº: ${response.data.invoice_code || ''})`
          : 'Fatura emitida com sucesso.'
      );
      RefreshList('.el-refresh-list');
      setRegisterStatus(2);
      resetForm();
      handleClose();
    } catch (error) {
      const msg = error?.response?.data?.msg || 'Lamentavelmente não foi possível emitir a fatura.';
      toast.error(msg);
      setRegisterStatus(1);
    }
  };

  const showPaymentDetails = paymentType !== '' && paymentType !== null;

  return (
    <div>
      <div onClick={handleShow}>
        {props.toggle_btn ? props.toggle_btn : (
          <button className="btn btn-main bg-main">
            <IoMdAddCircleOutline /> Nova Fatura
          </button>
        )}
      </div>

      <Modal
        size="lg"
        dialogAs={DraggableModal}
        centered
        className={showBox ? ModalAnimationShow() : ModalAnimationClose()}
        show={show}
        onHide={handleClose}
      >
        <Modal.Header closeButton>
          <Modal.Title>
            <div className="ed-wrap align-center">
              <UserOptionDropDown />
              <h5>Emitir Fatura</h5>
            </div>
          </Modal.Title>
        </Modal.Header>

        <Form onSubmit={FormSubmit}>
          <Modal.Body className="scrollLimit">

            <h6 style={{ fontWeight: 700, fontSize: 14, marginBottom: 12 }}>Dados do Cliente</h6>

            <Form.Group className="mb-3">
              <Form.Label>Nome<span className="text-danger ml-2">*</span></Form.Label>
              <Form.Control
                type="text"
                placeholder="Nome completo do cliente"
                value={clientName}
                onChange={(e) => { setClientName(e.target.value); setField('client_name'); }}
                isInvalid={!!errors.client_name}
              />
              <Form.Control.Feedback type="invalid">{errors.client_name}</Form.Control.Feedback>
            </Form.Group>

            <div className="ed-flex" style={{ gap: 10 }}>
              <Form.Group className="mb-3" style={{ flex: 1 }}>
                <Form.Label>NIF (opcional)</Form.Label>
                <Form.Control
                  type="text"
                  placeholder="Número de identificação fiscal"
                  value={clientNif}
                  onChange={(e) => setClientNif(e.target.value)}
                />
              </Form.Group>

              <Form.Group className="mb-3" style={{ flex: 1 }}>
                <Form.Label>Telefone (opcional)</Form.Label>
                <Form.Control
                  type="text"
                  placeholder="Ex: 923456789"
                  value={clientPhone}
                  onChange={(e) => setClientPhone(e.target.value)}
                />
              </Form.Group>
            </div>

            <div className="ed-flex" style={{ gap: 10 }}>
              <Form.Group className="mb-3" style={{ flex: 1 }}>
                <Form.Label>Endereço (opcional)</Form.Label>
                <Form.Control
                  type="text"
                  placeholder="Endereço do cliente"
                  value={clientAddress}
                  onChange={(e) => setClientAddress(e.target.value)}
                />
              </Form.Group>

              <Form.Group className="mb-3" style={{ flex: 1 }}>
                <Form.Label>Correio electrónico (opcional)</Form.Label>
                <Form.Control
                  type="email"
                  placeholder="cliente@email.com"
                  value={clientEmail}
                  onChange={(e) => setClientEmail(e.target.value)}
                />
              </Form.Group>
            </div>

            <hr className="my-3" />

            <h6 style={{ fontWeight: 700, fontSize: 14, marginBottom: 12 }}>Serviços e Itens da Fatura</h6>

            <Form.Group className="mb-2">
              <Form.Label>Seleccione os serviços<span className="text-danger ml-2">*</span></Form.Label>
              <MultiSelect
                options={allServices}
                value={selectedServices}
                onChange={setSelectedServices}
                labelledBy="Seleccione serviços"
              />
              {errors.services && <small className="text-danger d-block mt-1">{errors.services}</small>}
            </Form.Group>

            {hasOtherService && (
              <div style={{ background: '#fafafa', border: '1px solid #e0e0e0', borderRadius: 8, padding: 12, marginBottom: 12 }}>
                <h6 style={{ marginBottom: 10, color: '#374151', fontWeight: 600 }}>Detalhes do serviço personalizado</h6>

                <Form.Group className="mb-2">
                  <Form.Label>Nome ou Descrição<span className="text-danger ml-2">*</span></Form.Label>
                  <Form.Control
                    type="text"
                    placeholder="Ex: Aula particular, Serviço avulso..."
                    value={otherServiceName}
                    onChange={(e) => setOtherServiceName(e.target.value)}
                    isInvalid={!!errors.other_service_name}
                  />
                  <Form.Control.Feedback type="invalid">{errors.other_service_name}</Form.Control.Feedback>
                </Form.Group>

                <Form.Group>
                  <Form.Label>Valor<span className="text-danger ml-2">*</span></Form.Label>
                  <div className="input-group">
                    <Form.Control
                      type="number"
                      step="0.01"
                      min="0"
                      placeholder="0.00"
                      value={otherServiceValue}
                      onChange={(e) => setOtherServiceValue(e.target.value)}
                      isInvalid={!!errors.other_service_value}
                    />
                    <span className="input-group-text">{serviceCoin}</span>
                  </div>
                  {errors.other_service_value && <small className="text-danger d-block mt-1">{errors.other_service_value}</small>}
                </Form.Group>
              </div>
            )}

            {selectedServices.length > 0 && (
              <div className="ed-flex ed-wrapp mb-3" style={{ gap: 8 }}>
                {selectedServices.map((s) => {
                  if (s.value === OUTROS_SERVICE_ID) {
                    return (
                      <div key={s.value} className="badge bg-warning text-light ed-flex" style={{ padding: '8px 12px', borderRadius: 999 }}>
                        {otherServiceName || 'Serviço personalizado'} — {NumberToPrice(otherServiceValue || 0)} {serviceCoin}
                      </div>
                    );
                  }
                  const qty = amounts[s.value] || 1;
                  const info = allServices.find((a) => a.value === s.value);
                  return (
                    <div key={s.value} style={{ background: '#f4f6f8', borderRadius: 999, padding: '6px 10px', display: 'flex', alignItems: 'center', gap: 6 }}>
                      <span style={{ fontWeight: 600 }}>{s.label}</span>
                      <span>x {qty}</span>
                      <RemoveCircleOutline style={{ cursor: 'pointer', fontSize: 18 }} onClick={() => changeAmount(s.value, -1)} />
                      <AddCircleOutline style={{ cursor: 'pointer', fontSize: 18 }} onClick={() => changeAmount(s.value, +1)} />
                      <small style={{ color: '#6c757d' }}>({NumberToPrice(info?.price || 0)} {info?.coin || serviceCoin}/un.)</small>
                    </div>
                  );
                })}
              </div>
            )}

            <Form.Group className="mb-3">
              <Form.Label>Desconto global (%)</Form.Label>
              <Form.Control
                type="number"
                min="0"
                max="99"
                value={discountPercent}
                onChange={(e) => setDiscountPercent(e.target.value)}
                isInvalid={!!errors.discount_percent}
              />
              <Form.Control.Feedback type="invalid">{errors.discount_percent}</Form.Control.Feedback>
            </Form.Group>

            <Form.Group className="mb-3">
              <Form.Label>Observações</Form.Label>
              <Form.Control
                as="textarea"
                rows={2}
                placeholder="Notas gerais sobre esta fatura..."
                value={observations}
                onChange={(e) => setObservations(e.target.value)}
              />
            </Form.Group>

            <hr className="my-3" />

            <h6 style={{ fontWeight: 700, fontSize: 14, marginBottom: 12 }}>Método de Pagamento</h6>

            <Form.Group className="mb-3">
              <Form.Label>Método<span className="text-danger ml-2">*</span></Form.Label>
              <Form.Select
                value={paymentType}
                onChange={(e) => {
                  setPaymentType(e.target.value);
                  setField('payment_type');
                  if (Number(e.target.value) === 0) {
                    setPaymentBank('');
                    setPaymentPlace('');
                    setBordereauNumber('');
                  }
                }}
                isInvalid={!!errors.payment_type}
              >
                <option value="" disabled>Seleccione o método de pagamento...</option>
                {PAYMENT_METHODS.map((m) => (
                  <option key={m.value} value={m.value}>{m.label}</option>
                ))}
              </Form.Select>
              <Form.Control.Feedback type="invalid">{errors.payment_type}</Form.Control.Feedback>
            </Form.Group>

            {showPaymentDetails && Number(paymentType) === 0 && (
              <Form.Group className="mb-3">
                <Form.Label>Valor entregue</Form.Label>
                <Form.Control
                  type="number"
                  value={valueDelivered}
                  onChange={(e) => setValueDelivered(e.target.value)}
                />
              </Form.Group>
            )}

            {showPaymentDetails && Number(paymentType) !== 0 && (
              <>
                <Form.Group className="mb-3">
                  <Form.Label>Número de Borderô ou Referência<span className="text-danger ml-2">*</span></Form.Label>
                  <Form.Control
                    type="text"
                    placeholder="Ex: BDR-2025-001 ou nº do comprovativo TPA"
                    value={bordereauNumber}
                    onChange={(e) => setBordereauNumber(e.target.value)}
                    isInvalid={!!errors.bordereau_number}
                  />
                  <Form.Control.Feedback type="invalid">{errors.bordereau_number}</Form.Control.Feedback>
                </Form.Group>

                <Form.Group className="mb-3">
                  <Form.Label>Nome do Banco (opcional)</Form.Label>
                  <Form.Control
                    type="text"
                    placeholder="Ex: BFA, BAI, BIC…"
                    value={paymentBank}
                    onChange={(e) => setPaymentBank(e.target.value)}
                  />
                </Form.Group>

                <Form.Group className="mb-3">
                  <Form.Label>Local de Pagamento (opcional)</Form.Label>
