NODE_ENV=development
PORT=7500
APP_CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Ligação usada pela aplicação (config/DatabaseCredentials.js).
# Node e MySQL no mesmo servidor → 127.0.0.1 (evita ~174ms por query).
# Só para testar de outra máquina: MYSQL_HOST=cpanel154.dnscpanel.com
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Caminho explícito do socket MySQL (opcional; útil no cPanel).
MYSQL_SOCKET=
# Log HTTP: tiny (default, leve) ou dev (verboso).
LOG_HTTP=tiny
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT=30000
# Cache: true = ativa (SQLite/Redis). false = desliga sem alterar código.
CACHE_ENABLED=true
# Limite de disco da cache em MB (eviction automática acima disso).
CACHE_MAX_MB=200
# Teto de TTL das entradas de cache (segundos). 0 = sem teto.
CACHE_MAX_TTL=300
# Auditoria: false = texto local (rápido). true = Gemini (1–8s por escrita).
AUDIT_AI=false
# Diagnóstico: SQL_DEBUG=true mostra cada query; SLOW_QUERY_MS=300 loga só as lentas.
SQL_DEBUG=false
SLOW_QUERY_MS=0

# Variáveis legadas (mantidas por compatibilidade)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONN_LIMIT=20
DB_MAX_IDLE=10
SESSION_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
DEBUG_TOKEN=
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
GEMINI_API_KEY=
MAIL_APP_USER=
MAIL_APP_PASSWORD=
SMS_API_KEY=
REDIS_URL=